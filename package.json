{
  "name": "cambrian-api-mcp",
  "version": "1.3.7",
  "description": "Model Context Protocol server for Cambrian API - Access comprehensive DeFi data across Solana and EVM chains",
  "mcpName": "io.github.cambriannetwork/cambrian-api",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "cambrian-api-mcp": "dist/index.js"
  },
  "author": "Cambrian Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cambriannetwork/cambrian-api-mcp.git"
  },
  "homepage": "https://github.com/cambriannetwork/cambrian-api-mcp#readme",
  "bugs": {
    "url": "https://github.com/cambriannetwork/cambrian-api-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cambrian",
    "defi",
    "solana",
    "evm",
    "blockchain",
    "api",
    "ai"
  ],
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-bin-mode.mjs",
    "start": "node dist/index.js --transport http --host 0.0.0.0",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "ci": "npm test && npm run build",
    "check:public": "node scripts/check-public-release.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cambrian": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "express": {
      "path-to-regexp": "0.1.13"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
